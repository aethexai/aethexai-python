# Aethex AI SDK — local env template. Copy to `.env` and fill in.
# Usage (loading, etc.) is documented in the README "Environment variables" section.

# Required — API key for the AethexAI / Kora clients (sent as X-API-Key).
AETHEX_API_KEY=ae_live_...

# Optional — override the API base URL (honored by the example scripts).
AETHEX_BASE_URL=https://api.aethexai.com

# Optional — DeveloperClient only (JWT account/billing tokens).
AETHEX_DEVELOPER_ACCESS_TOKEN=
AETHEX_DEVELOPER_REFRESH_TOKEN=
