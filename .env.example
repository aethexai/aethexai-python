# Aethex AI SDK — local environment template.
#
# Copy to `.env` and fill in your values:
#   cp .env.example .env
#
# The SDK does not auto-load `.env`. Load it with uv's native flag (no extra
# dependency), e.g.:
#   uv run --env-file .env pytest -m integration
#   uv run --env-file .env python your_script.py
#
# `.env` is gitignored; never commit real keys.

# Required — API key for AethexAI / Kora clients (sent as X-API-Key).
# Get one from https://developers.aethexai.com/dashboard
AETHEX_API_KEY=ae_live_...

# Optional — override the API base URL (honored by the example scripts;
# the clients also accept base_url=... directly). Defaults to production.
AETHEX_BASE_URL=https://api.aethexai.com

# Optional — only for DeveloperClient (JWT-authenticated account/billing).
# These are developer-portal tokens, not an API key.
AETHEX_DEVELOPER_ACCESS_TOKEN=
AETHEX_DEVELOPER_REFRESH_TOKEN=
